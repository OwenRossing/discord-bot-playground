# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Discord -------------------------------------------------------------
# From https://discord.com/developers/applications
# Bot -> Token -> Reset Token. A full account credential for the bot.
DISCORD_TOKEN=

# General Information -> Application ID
DISCORD_CLIENT_ID=

# Optional. Set to a server id and `npm run register` publishes commands to
# that server only, which appears instantly instead of taking up to an hour.
DISCORD_GUILD_ID=

# Your own Discord user id. Grants /admin and the web panel, independent of
# any server's permissions. Leave blank to disable admin entirely.
SUPER_ADMIN_ID=

# --- Local console -------------------------------------------------------
WEB_PORT=4317

# 127.0.0.1 keeps the console on this machine. Set 0.0.0.0 to reach it from
# your phone on the same network -- WEB_TOKEN is then required.
WEB_HOST=127.0.0.1

# Shared secret for the console. Required whenever WEB_HOST is not localhost.
WEB_TOKEN=

# --- Appearance ----------------------------------------------------------
# "pixel" or "classic".
THEME=pixel
