# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Both come from https://discord.com/developers/applications

# Bot -> Token -> Reset Token. This is a full account credential for the bot.
DISCORD_TOKEN=

# General Information -> Application ID
DISCORD_CLIENT_ID=

# Optional. Set to a server id and `npm run register` publishes commands to
# that server only, which appears instantly instead of taking up to an hour.
DISCORD_GUILD_ID=

# Optional. "pixel" or "classic".
THEME=pixel
